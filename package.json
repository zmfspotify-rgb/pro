{
  "name": "minecraft-bot-pipeline",
  "version": "1.0.0",
  "description": "A multi-bot Minecraft content pipeline project powered by Node.js",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "pkg . --targets node18-win-x64 --output dist/launcher.exe",
    "build:all": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path dist"
  },
  "bin": {
    "minecraft-bot-pipeline": "src/index.js"
  },
  "keywords": [
    "minecraft",
    "bot",
    "pipeline",
    "automation"
  ],
  "author": "zmfspotify-rgb",
  "license": "MIT",
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "config/**/*"
    ],
    "outputPath": "dist"
  }
}
